<div class="d-flex flex-column gap-2">
    <div class="d-flex flex-wrap gap-2">
        <div class="d-flex align-items-center gap-1">
            <p class="theme-text">Country:</p>
            <input id="country" class="theme-input" />
        </div>

        <div class="d-flex align-items-center gap-1">
            <p class="theme-text">City:</p>
            <input id="city" class="theme-input" />
        </div>

        <div class="d-flex align-items-center gap-1">
            <p class="theme-text">Address:</p>
            <input id="address" class="theme-input" />
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        @if (!User.IsInRole("Operator"))
        {
            <label class="theme-radio">
                <input type="checkbox" name="placeTypeCheck" checked>
                <span class="theme-inner-radio"></span>
                <span class="theme-text">Accept point</span>
            </label>
        }

        <label class="theme-radio">
            <input type="checkbox" name="placeTypeCheck" checked>
            <span class="theme-inner-radio"></span>
            <span class="theme-text">Sorting point</span>
        </label>

        <label class="theme-radio">
            <input type="checkbox" name="placeTypeCheck" checked>
            <span class="theme-inner-radio"></span>
            <span class="theme-text">Pickup point</span>
        </label>
    </div>
</div>