<div class="d-flex flex-column theme-div theme-orange-4 p-3 del_min_w" style="max-width: 1000px; min-width: 1000px;">
    <h3 class="theme-text">List of admins</h3>

    <div class="table-responsive" style="max-height: 150px;">
        <table class="table table-warning table-sm text-center">
            <thead class="fw-bold">
                <tr>
                    <td style="width: 5%;">Id</td>
                    <td>Login</td>
                    <td>Name</td>
                    <td>Surname</td>
                    <td>Phone</td>
                    <td>Email</td>
                    <td>Password</td>
                    <td>Control</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var admin in Model.AdminAccounts)
                {
                    <tr>
                        <td>@admin.Id</td>
                        <td>@admin.Login</td>
                        <td>@admin.Name</td>
                        <td>@admin.Surname</td>
                        <td>@admin.Phone</td>
                        <td>@admin.Email</td>
                        <td>@admin.Password</td>
                        <td>
                            <form method="post" asp-action="DeleteAdmin">
                                <input type="hidden" name="id" value="@admin.Id" />
                                <button class="theme-button theme-button-table">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>