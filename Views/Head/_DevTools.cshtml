@model Delwings.Models.ViewModels.HeadPageVM;

<div class="d-flex flex-column gap-3">
    <div class="d-flex flex-column flex-grow-1 theme-div theme-orange-2 p-3">
        <h3 class="theme-text">Data Generator</h3>

        <div class="d-flex gap-2">
            <form method="post" asp-action="GeneratePlaces" asp-controller="Dev">
                <button class="theme-button theme-text">Generate 50 Places</button>
            </form>

            <form method="post" asp-action="GenerateOrders" asp-controller="Dev">
                <button class="theme-button theme-text">Generate 200 Orders</button>
            </form>

            <form method="post" asp-action="ClearPlaces" asp-controller="Dev">
                <button class="theme-button theme-text">Clear places</button>
            </form>

            <form method="post" asp-action="ClearOrders" asp-controller="Dev">
                <button class="theme-button theme-text">Clear orders</button>
            </form>
        </div>
    </div>

    <div class="d-flex flex-column flex-grow-1 theme-div theme-orange-2 p-3">
        <h2 class="theme-text">The number of elements: @Model.DeveloperModel.NumberOfElements</h2>

        <h4 class="theme-text">Bubble sort average time: @Math.Round(Model.DeveloperModel.BubbleSortTime, 2)</h4>
        <h4 class="theme-text">Quick sort average time: @Math.Round(Model.DeveloperModel.QuickSortTime, 2)</h4>
    </div>
</div>
