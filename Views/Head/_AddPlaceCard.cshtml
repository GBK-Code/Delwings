<form method="post" asp-action="AddPlace">
    <div class="theme-div d-flex flex-column flex-grow-1 theme-orange-2 p-3 gap-1" style="flex: 1;">
        <h3 class="theme-text">Add a place</h3>

        <div style="flex: 1; min-width: 0;">
            <div class="d-flex gap-2 res-to-col">
                <div class="d-flex flex-wrap flex-column justify-content-center gap-1">
                    <h6 class="theme-text">Country</h6>
                    <input class="theme-input" name="country" />

                    <h6 class="theme-text">City</h6>
                    <input class="theme-input" name="city" />
                </div>

                <div class="d-flex flex-wrap flex-column justify-content-center gap-1">

                    <h6 class="theme-text">Address</h6>
                    <input class="theme-input" name="address" />

                    <h6 class="theme-text">Contact</h6>
                    <input class="theme-input" name="contact" />
                </div>

                <div class="d-flex flex-wrap flex-column justify-content-center gap-1">
                    <h6 class="theme-text">Type of the place</h6>

                    <div class="d-flex flex-column gap-2">
                        <label class="theme-radio">
                            <input type="radio" name="placeType" value="AcceptPoint" checked>
                            <span class="theme-inner-radio"></span>
                            <span class="theme-text">Accept Point</span>
                        </label>

                        <label class="theme-radio">
                            <input type="radio" name="placeType" value="PickUpPoint">
                            <span class="theme-inner-radio"></span>
                            <span class="theme-text">Pick-Up Point</span>
                        </label>

                        <label class="theme-radio">
                            <input type="radio" name="placeType" value="SortingPoint">
                            <span class="theme-inner-radio"></span>
                            <span class="theme-text">Sorting Point</span>
                        </label>
                    </div>
                            
                </div>

            </div>
        </div>

        <button type="submit" class="theme-button theme-text">Add</button>
    </div>
</form>