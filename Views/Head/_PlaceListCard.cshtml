<div class="d-flex flex-column theme-orange-4 p-3 w-100">
    <h3 class="theme-text">List of Places</h3>

    <div class="table-responsive" style="max-height: 500px;">
        <table class="table table-warning table-sm text-center">
            <thead class="fw-bold">
                <tr>
                    <td style="width: 5%;">Id</td>
                    <td>Country</td>
                    <td>City</td>
                    <td>Address</td>
                    <td>Contact</td>
                    <td>Type</td>
                    <td>Control</td>
                </tr>
            </thead>
            <tbody>
                @foreach (var place in Model.Places)
                {
                    <tr>
                        <td>@place.Id</td>
                        <td>@place.Country</td>
                        <td>@place.City</td>
                        <td>@place.Address</td>
                        <td>@place.Contact</td>
                        <td>@place.Type</td>
                        <td>
                            <form method="post" asp-action="DeletePlace">
                                <input type="hidden" name="id" value="@place.Id" />
                                <button class="theme-button theme-button-table">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>