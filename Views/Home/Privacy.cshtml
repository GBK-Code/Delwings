@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="w-limit-90 justify-content-center">
    <div class="d-flex flex-column flex-grow-0">
        <h1 class="theme-text">@ViewData["Title"]</h1>
        <p class="theme-text">Effective Date: April 19, 2026</p>

        <h3 class="theme-text">1.General Information</h3>
        <p class="theme-text text">This Privacy Policy explains how the Delwings service collects, uses, and protects personal data of its users.</p>
        <p class="theme-text text">By using the Delwings service, you agree to the terms described in this Policy.</p>

        <h3 class="theme-text">2.Data We Collect</h3>

        <h5 class="theme-text">2.1.User Data</h5>
        <ul>
            <li>First and Last name</li>
            <li>Phone Number</li>
            <li>Email Address</li>
            <li>System User ID</li>
        </ul>

        <h5 class="theme-text">2.2.Order Data</h5>
        <ul>
            <li>Order Details</li>
            <li>Sender and Destination Addresses</li>
            <li>Tracking ID</li>
            <li>Order status and history</li>
        </ul>

        <h5 class="theme-text">2.3.Employee Data (Operators, Couriers, Administrators, Head administators)</h5>
        <ul>
            <li>Name and Contact information</li>
            <li>Assigned working locations</li>
            <li>Information about processed orders</li>
        </ul>

        <h3 class="theme-text">3.Purpose of Data Processing</h3>
        <ul>
            <li>processing and managing orders</li>
            <li>ensuring logistics and delivery operations</li>
            <li>tracking shipment status and location history</li>
            <li>assigning couriers and operators to tasks</li>
            <li>handling courier applications and approvals</li>
            <li>enabling QR-based package tracking</li>
            <li>maintaining order history and movement logs</li>
            <li>ensuring system security and role-based access control</li>
        </ul>

        <h3 class="theme-text">4.Access To Data</h3>
        <p>Access to data is strictly role-based:</p>
        <ul>
            <li>Administrator – full system management, users, and orders</li>
            <li>Operator – processing and updating orders at assigned locations</li>
            <li>Courier – access to assigned delivery tasks</li>
            <li>User – access only to their own orders</li>
        </ul>

        <h3 class="theme-text">5.Data Sharing</h3>
        <p class="theme-text">Delwings does not share personal data with third parties, except when required by applicable law.</p>
    </div>    
</div>
