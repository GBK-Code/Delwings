@model List<Delwings.Models.ViewModels.Tables.OrderRowVM>;

<div class="d-flex flex-column theme-orange-4 p-3 w-100">
    <h3 class="theme-text">List of Orders</h3>

    <div class="table-responsive" style="max-height: 500px;">
        <table class="table table-warning table-sm text-center">
            <thead class="fw-bold">
                <tr>
                    <th style="width: 3%">Id</th>
                    <th>Date</th>
                    <th style="width: 5%;">Time</th>
                    <th style="width: 5%">Sender</th>
                    <th>Location</th>
                    <th>Destination</th>
                    <th>Contact</th>
                    <th>Type</th>
                    <th>Courier</th>
                    <th>Insurance</th>
                    <th>Price</th>
                    <th>Control</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var row in Model)
                {
                    <tr>
                        <td>@row.OrderRow!.Id</td>
                        <td>@row.OrderRow.Date</td>
                        <td>@row.OrderRow.Time</td>
                        <td>@row.OrderRow.SenderId</td>

                        <td class="text-truncate-cell">
                            @if (@row.PlaceRow != null)
                            {
                                @($"{@row.PlaceRow.Country}, {@row.PlaceRow.City}, {@row.PlaceRow.Address}")
                            }
                            else
                            {
                                <form method="post" asp-action="AssignOrderPlace" class="d-flex gap-1">
                                    <input type="hidden" name="orderId" value="@row.OrderRow.Id" />

                                    <input name="trackId" class="theme-input form-control form-control-sm" placeholder="Track" required />
                                    <button class="theme-button theme-button-table">OK</button>
                                </form>
                            }
                        </td>

                        <td class="text-truncate-cell">@row.OrderRow.Destination</td>
                        <td class="text-truncate-cell">@row.OrderRow.ReceiverContact</td>
                        <td>@row.OrderRow.OrderType</td>

                        <td>@row.AccountRow?.Name</td>
                        <td class="text-truncate-cell">@row.OrderRow.InsuranceCompany</td>
                        <td>@row.OrderRow.InsurancePrice</td>

                        <td>
                            <div class="d-flex flex-wrap gap-1 justify-content-center">
                                <form method="get" asp-action="EditOrder">
                                    <input type="hidden" name="id" value="@row.OrderRow.Id" />
                                    <button class="theme-button theme-button-table">Edit</button>
                                </form>

                                <form method="post" asp-action="DeleteOrder">
                                    <input type="hidden" name="orderId" value="@row.OrderRow.Id" />
                                    <button class="theme-button theme-button-table">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>