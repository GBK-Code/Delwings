@model Delwings.Models.ViewModels.OperatorPageVM;

<div class="d-flex flex-column theme-orange-4 p-3 w-100">
    <h3 class="theme-text">List of Orders</h3>

    <div class="table-responsive" style="max-height: 500px;">
        <table class="table table-warning table-sm text-center">
            <thead class="fw-bold">
                <tr>
                    <th style="width: 3%">Id</th>
                    <th>Date</th>
                    <th style="width: 5%;">Time</th>
                    <th style="width: 5%">Sender</th>
                    <th>Location</th>
                    <th>Destination</th>
                    <th>Contact</th>
                    <th>Type</th>
                    <th>Courier</th>
                    <th>Insurance</th>
                    <th>Price</th>
                    <th>Control</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var order in Model.OrdersList)
                {
                    <tr>
                        <td>@order.Id</td>
                        <td>@order.Date</td>
                        <td>@order.Time</td>
                        <td>@order.SenderId</td>

                        @{
                            var place = Model.PlacesList.FirstOrDefault(p => p.Id == order.CurrentLocationId);
                        }

                        <td class="text-truncate-cell">
                            @if (place != null)
                            {
                                @($"{place.Country}, {place.City}, {place.Address}")
                            }
                            else
                            {
                                <form method="post" asp-action="AssignOrderPlace" class="d-flex gap-1">
                                    <input type="hidden" name="orderId" value="@order.Id" />
                                    <input type="hidden" name="placeId" value="@Model.WorkingPlace.Id" />

                                    <input name="trackId" class="theme-input form-control form-control-sm" placeholder="Track" required />
                                    <button class="theme-button theme-button-table">OK</button>
                                </form>
                            }
                        </td>

                        <td class="text-truncate-cell">@order.Destination</td>
                        <td class="text-truncate-cell">@order.ReceiverContact</td>
                        <td>@order.OrderType</td>

                        @{
                            var courier = Model.AcceptedCourierList.FirstOrDefault(u => u.Id == order.CourierId);
                        }

                        <td>@courier?.Name</td>
                        <td class="text-truncate-cell">@order.InsuranceCompany</td>
                        <td>@order.InsurancePrice</td>

                        <td>
                            <div class="d-flex flex-wrap gap-1 justify-content-center">
                                <form method="get" asp-action="EditOrder">
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <input type="hidden" name="date" value="@order.Date" />
                                    <input type="hidden" name="time" value="@order.Time" />
                                    <input type="hidden" name="senderId" value="@order.SenderId" />
                                    <input type="hidden" name="trackId" value="@order.TrackId" />
                                    <input type="hidden" name="receiverNumber" value="@order.ReceiverNumber" />
                                    <input type="hidden" name="destination" value="@order.Destination" />
                                    <input type="hidden" name="contact" value="@order.ReceiverContact" />
                                    <input type="hidden" name="currentPlaceId" value="@order.CurrentLocationId" />
                                    <input type="hidden" name="orderType" value="@order.OrderType" />
                                    <input type="hidden" name="courierId" value="@order.CourierId" />
                                    <input type="hidden" name="insuranceCompany" value="@order.InsuranceCompany" />
                                    <input type="hidden" name="insurancePrice" value="@order.InsurancePrice" />

                                    <button class="theme-button theme-button-table">Edit</button>
                                </form>

                                <form method="post" asp-action="DeleteOrder">
                                    <input type="hidden" name="orderId" value="@order.Id" />
                                    <button class="theme-button theme-button-table">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>