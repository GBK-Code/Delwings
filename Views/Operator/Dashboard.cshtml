@model Delwings.Models.ViewModels.OperatorPageVM;

<div class="d-flex flex-column w-limit-90 gap-2">
    <h1 class="theme-text">Operator Panel</h1>

    <div class="d-flex align-items-start gap-4 res-to-col mw-100" style="min-width: 0;">
        @* Tabs *@
        <partial name="_TabsCard" />

        @if (Model.Tab == "overview")
        {
            <partial name="_Overview" />
        }
        
        @if (Model.Tab == "redirection")
        {
            <div class="mw-100">
                <partial name="_RedirectionCard" />
            </div>
        }

        @if (Model.Tab == "orders")
        {
            <div class="d-flex flex-column mw-100 gap-4">
                @if (Model.WorkingPlace.Type == Delwings.Models.Enums.PlaceTypes.AcceptPoint)
                {
                    <partial name="_AddOrderCard" />
                }
    
                @if (Model.WorkingPlace.Type == Delwings.Models.Enums.PlaceTypes.PickUpPoint)
                {
                    <partial name="_ReleaseOrderCard" />
                }

                <div class="mw-100" style="min-width: 0px; overflow: hidden;">
                    <partial name="_OrdersListCard" />
                </div>
            </div>
        }

        @if (Model.Tab == "tables")
        {
            <div class="d-flex flex-column mw-100 gap-1">
                
                <partial name="_OrdersFilterCard" />

                <div id="ordersSearchTable" style="min-width: 0px; overflow: hidden;">
                    <partial name="_OrdersListCard" />
                </div>
            </div>
        }
    </div>
</div>

<script src="~/js/orderFieldsManipulator.js"></script>