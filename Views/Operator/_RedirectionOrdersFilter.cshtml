@* Fiters *@
<div class="d-flex flex-wrap gap-2">
    <div class="d-flex align-items-center gap-1">
        <p class="theme-text">Track Id:</p>
        <input id="trackInput" class="theme-input" />
    </div>

    <div class="d-flex align-items-center gap-1">
        <p class="theme-text">Address:</p>
        <input id="addressInput" class="theme-input" />
    </div>

    <label class="theme-radio">
        <input type="checkbox" name="typeCheck" checked>
        <span class="theme-inner-radio"></span>
        <span class="theme-text">Accept Point</span>
    </label>

    <label class="theme-radio">
        <input type="checkbox" name="typeCheck" checked>
        <span class="theme-inner-radio"></span>
        <span class="theme-text">Sorting Point</span>
    </label>

    <label class="theme-radio">
        <input type="checkbox" name="typeCheck" checked>
        <span class="theme-inner-radio"></span>
        <span class="theme-text">PickUp Point</span>
    </label>
</div>

<script src="~/js/redirectOrdersFilter.js"></script>