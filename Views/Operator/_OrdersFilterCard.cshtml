@* Fiters *@
<div class="d-flex flex-column theme-div theme-orange-2 p-1 gap-2">
    <div class="d-flex flex-wrap gap-2">
        <div class="d-flex align-items-center gap-1">
            <p class="theme-text">From:</p>
            <input id="dateFrom" type="date" class="theme-input" />
        </div>

        <div class="d-flex align-items-center gap-1">
            <p class="theme-text">To:</p>
            <input id="dateTo" type="date" class="theme-input" />
        </div>

        <button id="ordersFilterButton" class="theme-button theme-text">Filter</button>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <label class="theme-radio">
            <input type="checkbox" name="ordinaryOrderCheck" value="OrdinaryOrder" checked>
            <span class="theme-inner-radio"></span>
            <span class="theme-text">Ordinary Order</span>
        </label>

        <label class="theme-radio">
            <input type="checkbox" name="insuredOrderCheck" value="InsuredOrder" checked>
            <span class="theme-inner-radio"></span>
            <span class="theme-text">Insured Order</span>
        </label>

        <label class="theme-radio">
            <input type="checkbox" name="expressOrderCheck" value="ExpressOrder" checked>
            <span class="theme-inner-radio"></span>
            <span class="theme-text">Express Order</span>
        </label>
    </div>
</div>

<script src="~/js/ordersDateFilter.js"></script>