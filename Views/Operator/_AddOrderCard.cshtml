<form method="post" asp-action="AddOrder">
    <div class="theme-div d-flex flex-column flex-grow-1 theme-orange-2 p-3 gap-1">
        <h3 class="theme-text">Add an Order</h3>
        <input type="hidden" name="currentPlaceId" value="@Model.WorkingPlace.Id" />

        <div class="d-flex gap-2 res-to-col">
            <div class="d-flex flex-wrap flex-column justify-content-center gap-1 align-self-start">
                <h6 class="theme-text">Type of the order</h6>

                <div class="d-flex flex-column gap-1">
                    <label class="theme-radio">
                        <input type="radio" name="orderType" value="@Delwings.Models.Enums.OrderTypes.Ordinary" checked>
                        <span class="theme-inner-radio"></span>
                        <span class="theme-text">Ordinary Order</span>
                    </label>

                    <label class="theme-radio">
                        <input type="radio" name="orderType" value="@Delwings.Models.Enums.OrderTypes.Insured">
                        <span class="theme-inner-radio"></span>
                        <span class="theme-text">Insured Order</span>
                    </label>

                    <label class="theme-radio">
                        <input type="radio" name="orderType" value="@Delwings.Models.Enums.OrderTypes.Express">
                        <span class="theme-inner-radio"></span>
                        <span class="theme-text">Express Order</span>
                    </label>
                </div>
            </div>

            <div class="d-flex flex-wrap flex-column justify-content-center gap-1">
                <h6 class="theme-text">Date</h6>
                <input type="date" class="theme-input" name="date" />

                <h6 class="theme-text">Time</h6>
                <input type="time" class="theme-input" name="time" />
            </div>

            <div class="d-flex flex-wrap flex-column justify-content-center gap-1">
                <h6 class="theme-text">Sender Id</h6>
                <input type="number" min="0" class="theme-input" name="senderId" />

                <h6 class="theme-text">Receiver contact</h6>
                <input class="theme-input" name="contact" />
            </div>

            @* Это должно быть видно только при выборе InsuranceOrder *@
            <div id="insuranceFields" class="d-flex flex-wrap flex-column justify-content-center gap-1">
                <h6 class="theme-text">Insurance company</h6>
                <input class="theme-input" name="insuranceCompany" />

                <h6 class="theme-text">Insurance price</h6>
                <input type="number" min="500" class="theme-input" name="insurancePrice" />
            </div>

            <div class="d-flex flex-wrap flex-column justify-content-center gap-1">
                <h6 class="theme-text">Track ID</h6>
                <input class="theme-input" name="trackId" />

                <h6 class="theme-text">Destination</h6>
                <input class="theme-input" name="destination" />
            </div>

            <div id="expressFields" class="table-responsive">
                <table class="table table-warning table-sm text-center align-middle">
                    <thead>
                        <tr>
                            <td style="width: 5%;">Id</td>
                            <td>Name</td>
                            <td>Surname</td>
                            <td>Phone</td>
                            <td>Email</td>
                            <td>Assign</td>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var courier in Model.AcceptedCourierList)
                        {
                            <tr>
                                <td>@courier.Id</td>
                                <td>@courier.Name</td>
                                <td>@courier.Surname</td>
                                <td>@courier.Phone</td>
                                <td>@courier.Email</td>
                                <td>
                                    <label class="theme-radio">
                                        <input type="radio" name="courierId" value="@courier.Id" />
                                        <span class="theme-inner-radio"></span>
                                        <span>Assign</span>
                                    </label>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <button type="submit" class="theme-button theme-text">Add</button>
    </div>
</form>