<form method="post" asp-action="ReleaseOrder">
    <div class="theme-div d-flex flex-column flex-grow-1 theme-orange-2 p-3 gap-1 align-items-center">
        <h3 class="theme-text">Release order</h3>

        <div class="d-flex flex-wrap">
            <img src="~/css/svg/box.svg" style="max-width: 80px;" />

            <div class="d-flex flex-column gap-2">
                <h6 class="theme-text">Receiver number: </h6>
                <input class="theme-input" type="number" name="receiverNumber" />
                <button class="theme-button flex-grow-1 theme-text">Release order</button>
            </div>
        </div>
    </div>
</form>