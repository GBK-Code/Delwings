@model Delwings.Models.OperatorPageVM;


<form method="post" asp-action="RedirectCourier">
    <div class="d-flex flex-column theme-div theme-orange-2 p-3 gap-3">
        <div class="d-flex flex-wrap justify-content-between gap-3">
            <div class="theme-orange-3 flex-grow-1 p-3 w-100">
                <h5 class="theme-text">Orders Pending</h5>

                <div class="table-responsive">
                    <table class="table table-warning table-sm text-center align-middle">
                        <thead class="fw-bold">
                            <tr>
                                <td style="width: 5%;">Order ID</td>
                                <td>Track ID</td>
                                <td>Current At</td>
                                <td>Place Type</td>
                                <td>Select</td>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.OrdersList)
                            {
                                if (order.IsCarried) { continue; }

                                var courierOrder = Model.CourierOrders.Where(ord => ord.OrderId == order.Id).FirstOrDefault();
                                if (courierOrder != null) { continue; }
                                var location = Model.PlacesList.Where(place => place.Id == order.CurrentLocationId).FirstOrDefault();

                                <tr>
                                    <td>@order.Id</td>
                                    <td>@order.TrackId</td>
                                    @if (location != null)
                                    {
                                        <td>@location.Country, @location.City, @location.Address</td>
                                        <td>@location.Type</td>
                                    }

                                    <td>
                                        <label class="theme-radio">
                                            <input type="radio" name="orderId" value="@order.Id" required />
                                            <span class="theme-inner-radio"></span>
                                            <span>Select</span>
                                        </label>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="theme-orange-3 flex-grow-1 p-3 w-100">
                <h5 class="theme-text">Couriers Available</h5>

                <div class="table-responsive">
                    <table class="table table-warning table-sm text-center align-middle">
                        <thead class="fw-bold">
                            <tr>
                                <td style="width: 5%;">ID</td>
                                <td>Name</td>
                                <td>Select</td>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var courier in Model.CourierList)
                            {
                                if (courier == null) { continue; }
                                <tr>
                                    <td>@courier.Id</td>
                                    <td>@courier.Name</td>

                                    <td>
                                        <label class="theme-radio">
                                            <input type="radio" name="courierId" value="@courier.Id" required />
                                            <span class="theme-inner-radio"></span>
                                            <span>Select</span>
                                        </label>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="theme-orange-3 flex-grow-1 p-3 w-100">
                <h5 class="theme-text">List of Places</h5>

                <div class="table-responsive">
                    <table class="table table-warning table-sm text-center align-middle">
                        <thead class="fw-bold">
                            <tr>
                                <td style="width: 5%;">ID</td>
                                <td>Address</td>
                                <td>Type</td>
                                <td>Select</td>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var place in Model.PlacesList)
                            {
                                if (place.Type == Delwings.Models.Enums.PlaceTypes.AcceptPoint) { continue; }
                                
                                <tr>
                                    <td>@place.Id</td>
                                    <td>@place.Country, @place.City, @place.Address</td>
                                    <td>@place.Type</td>

                                    <td>
                                        <label class="theme-radio">
                                            <input type="radio" name="placeId" value="@place.Id" required />
                                            <span class="theme-inner-radio"></span>
                                            <span>Select</span>
                                        </label>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <button class="theme-button theme-text flex-grow-1">Redirect Courier</button>
    </div>
</form>