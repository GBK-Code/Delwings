@model Delwings.Models.ViewModels.OperatorPageVM;


<form method="post" asp-action="RedirectCourier">
    <div class="d-flex flex-column theme-div theme-orange-2 p-3 gap-3">
        <div class="d-flex flex-wrap justify-content-between gap-3">
            <div class="d-flex flex-column theme-orange-3 flex-grow-1 gap-2 p-3 w-100">
                <h5 class="theme-text">Orders Pending</h5>

                <partial name="_RedirectionOrdersFilter" />
                <div id="pendingOrdersTable">
                    <partial name="_RedirectOrdersList" />
                </div>
                
            </div>

            <div class="theme-orange-3 flex-grow-1 p-3 w-100">
                <h5 class="theme-text">Couriers Available</h5>

                <div class="table-responsive" style="max-height: 200px;">
                    <table class="table table-warning table-sm text-center align-middle">
                        <thead class="fw-bold">
                            <tr>
                                <td style="width: 5%;">ID</td>
                                <td>Name</td>
                                <td>Select</td>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var courier in Model.AcceptedCourierList)
                            {
                                if (courier == null) { continue; }
                                <tr>
                                    <td>@courier.Id</td>
                                    <td>@courier.Name</td>

                                    <td>
                                        <label class="theme-radio">
                                            <input type="radio" name="courierId" value="@courier.Id" required />
                                            <span class="theme-inner-radio"></span>
                                            <span>Select</span>
                                        </label>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="d-flex flex-column gap-2 theme-orange-3 flex-grow-1 p-3 w-100">
                <h5 class="theme-text">List of Places</h5>

                <partial name="_PlaceFilterCard" />

                <div id="placesFilteredTable">
                    <partial name="_RedirectionPlacesList.cshtml" />
                </div>
            </div>
        </div>

        <button class="theme-button theme-text flex-grow-1">Redirect Courier</button>
    </div>
</form>