@model Delwings.Models.EditOrderPAgeVM;


<div class="d-flex flex-column w-limit-90 gap-2">
    <h1 class="theme-text">Edit Order</h1>

    <div class="d-flex">
        <div class="w-limit-90">
            <div class="d-flex gap-5">
                <div>
                    <h4 class="theme-text">Id: @Model.Order.Id</h4>
                    <h4 class="theme-text">Sender Id: @Model.Order.SenderId</h4>
                    <h4 class="theme-text">Date: @Model.Order.Date</h4>
                    <h4 class="theme-text">Time: @Model.Order.Time</h4>
                </div>

                <div>
                    <h4 class="theme-text">Receiver contact: @Model.Order.ReceiverContact</h4>
                    @if (Model.Order.OrderType == Delwings.Models.Enums.OrderTypes.Express)
                    {
                        <h4 class="theme-text">Courier Name: @Model.Courier?.Name</h4>
                    }
                    @if (Model.Order.OrderType == Delwings.Models.Enums.OrderTypes.Insured)
                    {
                        <h4 class="theme-text">Insurance Company: @Model.Order.InsuranceCompany</h4>
                        <h4 class="theme-text">Insurance Price: @Model.Order.InsurancePrice</h4>
                    }
                </div>
            </div>
            <form method="post" asp-action="SubmitEdit">
                <input type="hidden" name="id" value="@Model.Order.Id" />
                <input type="hidden" name="trackId" value="@Model.Order.TrackId" />

                <div class="theme-div d-flex flex-column flex-grow-1 theme-orange-2 p-3 gap-1">
                    <h3 class="theme-text">Edit the Order</h3>

                    <div class="d-flex gap-2 res-to-col w-limit-90">
                        <div class="d-flex flex-wrap flex-column justify-content-center gap-1">
                            <h6 class="theme-text">Date</h6>
                            <input type="date" class="theme-input" name="date" value="@Model.Order.Date"/>

                            <h6 class="theme-text">Time</h6>
                            <input type="time" class="theme-input" name="time" value="@Model.Order.Time" />
                        </div>

                        <div class="d-flex flex-wrap flex-column justify-content-center gap-1">
                            <h6 class="theme-text">Sender Id</h6>
                            <input type="number" min="0" class="theme-input" name="senderId" value="@Model.Order.SenderId" />

                            <h6 class="theme-text">Receiver contact</h6>
                            <input class="theme-input" name="contact" value="@Model.Order.ReceiverContact" />
                        </div>

                        @if(Model.Order.OrderType == Delwings.Models.Enums.OrderTypes.Express)
                        {
                            <div id="expressFields" class="d-flex flex-wrap flex-column justify-content-center gap-1">
                                <h6 class="theme-text">Courier Id</h6>
                                <input type="number" min="0" class="theme-input" name="courierId" value="@Model.Courier?.Id" />
                            </div>
                        }

                        @if(Model.Order.OrderType == Delwings.Models.Enums.OrderTypes.Insured)
                        { 
                            <div id="insuranceFields" class="d-flex flex-wrap flex-column justify-content-center gap-1">
                                <h6 class="theme-text">Insurance company</h6>
                                <input class="theme-input" name="insuranceCompany" value="@Model.Order.InsuranceCompany"/>

                                <h6 class="theme-text">Insurance price</h6>
                                <input type="number" min="500" class="theme-input" name="insurancePrice" value="@Model.Order.InsurancePrice"/>
                            </div>
                        }

                    </div>

                    <button type="submit" class="theme-button theme-text">Edit</button>
                </div>
            </form>
        </div>
    </div>
</div>