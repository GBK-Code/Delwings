<div class="d-flex theme-div theme-orange-2 p-3 w-limit-90 justify-content-evenly">
    <img src="~/css//svg/job.svg" class="flex-shrink-0" style="max-width: 150px; height: auto" />
    <div>
        <h3 class="theme-text">Name: @Model.Account.Name, @Model.Account.Surname</h3>
        <h4 class="theme-text">Login: @Model.Account.Login</h4>
        <div>
            <p class="theme-text">@Model.Account.Phone</p>
            <p class="theme-text text-break">Email: @Model.Account.Email</p>
        </div>

        <form method="post" asp-action="Logout" asp-controller="Auth">
            <button type="submit" class="theme-button">Logout</button>
        </form>
    </div>
</div>